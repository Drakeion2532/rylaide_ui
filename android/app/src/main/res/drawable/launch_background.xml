<?xml version="1.0" encoding="utf-8"?>
<!-- Splash for Android 8–11: asphalt background with the app icon in the middle -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item android:gravity="center" android:width="160dp" android:height="160dp">
        <bitmap android:gravity="fill" android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
